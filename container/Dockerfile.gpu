# ---------------------------------------------------------------------------
# Stage 1: Frontend build — use the official Node.js image (same as CPU Dockerfile).
#
# Rationale: The previous Dockerfile.gpu built the frontend inside a
# nvidia/cuda base image, installing Node.js from nodesource.  Using
# node:22-bookworm instead:
#   • Avoids downloading ~200 MB of CUDA dev tools just to run `npm ci`.
#   • Reuses the exact same build environment as the CPU Dockerfile so the
#     frontend artefacts are byte-identical across CPU and GPU images.
#   • Speeds up builds thanks to Docker layer caching of the Node base image.
# ---------------------------------------------------------------------------
FROM node:22-bookworm AS frontend-build

WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json frontend/tsconfig.json frontend/tsconfig.node.json frontend/vite.config.ts frontend/index.html ./
COPY frontend/src ./src
# `npm install` (not `npm ci`) so optional platform-specific binaries (e.g.
# @rollup/rollup-linux-arm64-gnu) resolve on the current platform even when
# package-lock.json was generated on a different OS.
RUN npm install --no-audit --no-fund && npm run build

# ---------------------------------------------------------------------------
# Stage 2: Runtime — CUDA runtime image for GPU inference.
#
# The runtime flavour ships the CUDA driver shim and libraries needed at
# inference time but omits nvcc / headers.  This keeps the final image
# smaller.  If a future GPU dependency requires compilation against CUDA
# headers during pip install, insert a temporary "devel" builder stage
# (e.g. nvidia/cuda:12.6.1-devel-ubuntu22.04) to build the wheel, then copy
# the wheel into the runtime stage.
# ---------------------------------------------------------------------------
FROM nvidia/cuda:12.6.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SUBPIPELINE_DB_PATH=/config/subpipeline.db \
    SUBPIPELINE_FRONTEND_DIST=/app/frontend/dist \
    SUBPIPELINE_PORT=8000

RUN apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        python3 python3-pip python3-venv libpython3.10 supervisor ffmpeg curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r appgroup && useradd -r -g appgroup -d /app -s /sbin/nologin app

WORKDIR /app
COPY backend/requirements-gpu.txt /app/backend/requirements-gpu.txt
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && python3 -m pip install --no-cache-dir "numpy<2" \
    && python3 -m pip install --no-cache-dir --no-build-isolation -r /app/backend/requirements-gpu.txt \
    && mkdir -p /data /output /models /config \
    && chown -R app:appgroup /data /output /models /config

COPY --chown=app:appgroup backend /app/backend
COPY --chown=app:appgroup --from=frontend-build /app/frontend/dist /app/frontend/dist
COPY container/supervisord.conf /etc/supervisor/conf.d/subpipeline.conf

EXPOSE 8000
VOLUME ["/data", "/output", "/models", "/config"]

USER app

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/subpipeline.conf"]
